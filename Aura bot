def process_update(update):
    if "callback_query" in update:
        cq = update["callback_query"]
        query_id = cq["id"]
        chat_id = cq["message"]["chat"]["id"]
        message_id = cq["message"]["message_id"]
        data = cq["data"]

        requests.post(f"{BASE_URL}/answerCallbackQuery", json={"callback_query_id": query_id})

        if data == "home":
            edit_message(chat_id, message_id, "🧬 *Aura 23-Pairs Forex Engine*\n\nSeleziona il mercato:", reply_markup=get_main_menu())
        elif data == "cat_forex":
            edit_message(chat_id, message_id, "⚙️ Seleziona una delle 23 coppie di valute:", reply_markup=get_category_keyboard())
        elif data.startswith("asset_"):
            ticker = data.replace("asset_", "")
            edit_message(chat_id, message_id, f"📌 Asset selezionato: *{ticker}*\n\nSeleziona il timeframe (M1, M3 o M5):", reply_markup=get_timeframe_keyboard(ticker))
        elif data.startswith("tf_"):
            parts = data.split("_")
            ticker = parts[1]
            tf = parts[2]

            edit_message(chat_id, message_id, f"⏳ *Analisi in corso per {ticker} ({tf})...*")

            direction, emoji, win_rate = ottieni_dati_live_forex(ticker)

            if direction is None:
                edit_message(chat_id, message_id, "⚠️ Errore di connessione al flusso live. Riprova.", reply_markup=get_main_menu())
                return

            scad = SCADENZE.get(tf, 60)
            entry_time = get_next_candle_time(scad)

            msg = (
                f"💎 *SEGNALE FOREX* 💎\n"
                f"────────────────────────\n"
                f"{emoji} *Direzione:* `{direction}`\n"
                f"🔹 *Asset:* `{ticker}` ({tf})\n"
                f"⏰ *Ingresso Obbligatorio:* `{entry_time}`\n"
                f"📊 *Win Rate Statistico:* `{win_rate}%`\n"
                f"💰 *Size Operativa:* `1% Capitale`"
            )

            send_message(CHAT_ID, msg)
            edit_message(chat_id, message_id, "✅ Segnale inviato con successo sul canale.", reply_markup=get_main_menu())

    elif "message" in update:
        msg = update["message"]
        chat_id = msg["chat"]["id"]
        if msg.get("text", "").startswith("/start"):
            send_message(chat_id, "🚀 *Aura 23-Pairs Bot Pronto*\n\nTutte le coppie Forex sono caricate e pronte all'uso.", reply_markup=get_main_menu())

def main():
    print("BOT 23 VALUTE FOREX ATTIVO SU PYDROID 3")
    offset = 0
    while True:
        try:
            r = requests.get(f"{BASE_URL}/getUpdates?offset={offset}&timeout=30", timeout=35).json()
            if r.get("ok"):
                for res in r.get("result", []):
                    offset = res["update_id"] + 1
                    process_update(res)
        except Exception as e:
            print(f"Errore: {e}")
            time.sleep(3)

if __name__ == "__main__":
    main()
